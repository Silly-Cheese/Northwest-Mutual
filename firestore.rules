rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Owner rights are granted by the local Admin SDK bootstrap script,
    // never by matching a self-reported/unverified email address.
    function isOwner() {
      return signedIn() && request.auth.token.owner == true;
    }
    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function isStaff() { return isOwner() || hasRole('staff'); }
    function isProvider() { return hasRole('provider'); }
    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 80;
    }
    function validCustomerProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid','email','displayName','role','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid','email','displayName','role','createdAt','updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'customer'
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function activePlan(planId) {
      return planId is string
        && exists(/databases/$(database)/documents/plans/$(planId))
        && get(/databases/$(database)/documents/plans/$(planId)).data.active == true;
    }
    function activePolicy(uid) {
      return exists(/databases/$(database)/documents/policies/$(uid))
        && get(/databases/$(database)/documents/policies/$(uid)).data.status == 'active';
    }
    function validCustomerPolicy(uid) {
      return request.resource.data.keys().hasOnly([
          'uid','plan','status','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid','plan','status','createdAt','updatedAt'
        ])
        && request.resource.data.uid == uid
        && activePlan(request.resource.data.plan)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function validPlanData() {
      return request.resource.data.keys().hasOnly([
          'name','description','price','coverage','deductible','active','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name','description','price','coverage','deductible','active','createdAt','updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 70
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 400
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 1000000
        && request.resource.data.coverage is int
        && request.resource.data.coverage >= 0
        && request.resource.data.coverage <= 100
        && request.resource.data.deductible is number
        && request.resource.data.deductible >= 0
        && request.resource.data.deductible <= 1000000
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }
    function validClaimCreate() {
      return request.resource.data.keys().hasOnly([
          'customerUid','providerUid','submittedBy','facility','invoiceNumber','serviceDate',
          'serviceType','notes','amount','status','approvedAmount',
          'payoutStatus','decisionNote','reviewedBy','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'customerUid','providerUid','submittedBy','facility','invoiceNumber','serviceDate',
          'serviceType','notes','amount','status','approvedAmount',
          'payoutStatus','decisionNote','reviewedBy','createdAt','updatedAt'
        ])
        && request.resource.data.customerUid is string
        && request.resource.data.customerUid.size() >= 6
        && request.resource.data.customerUid.size() <= 128
        && request.resource.data.submittedBy == request.auth.uid
        && (
          (request.resource.data.customerUid == request.auth.uid
           && request.resource.data.providerUid == null)
          || (isProvider() && request.resource.data.providerUid == request.auth.uid)
        )
        && activePolicy(request.resource.data.customerUid)
        && request.resource.data.facility is string
        && request.resource.data.facility.size() >= 1
        && request.resource.data.facility.size() <= 100
        && request.resource.data.invoiceNumber is string
        && request.resource.data.invoiceNumber.size() >= 1
        && request.resource.data.invoiceNumber.size() <= 64
        && request.resource.data.invoiceNumber.matches('^[A-Za-z0-9][A-Za-z0-9._/ -]{0,63}$')
        && request.resource.data.serviceDate is string
        && request.resource.data.serviceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.serviceType in [
          'Office Visit','Emergency Care','Hospital Stay','Imaging',
          'Medication','Laboratory','Surgery','Other'
        ]
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.status == 'pending'
        && request.resource.data.approvedAmount == 0
        && request.resource.data.payoutStatus == 'unpaid'
        && request.resource.data.decisionNote == ''
        && request.resource.data.reviewedBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function validClaimDecision() {
      return resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','approvedAmount','decisionNote','reviewedBy','payoutStatus','updatedAt'
        ])
        && request.resource.data.status in ['approved','partially_approved','denied']
        && request.resource.data.payoutStatus == 'unpaid'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.decisionNote is string
        && request.resource.data.decisionNote.size() <= 500
        && request.resource.data.approvedAmount is number
        && (
          (request.resource.data.status == 'approved'
            && request.resource.data.approvedAmount == resource.data.amount)
          || (request.resource.data.status == 'partially_approved'
            && request.resource.data.approvedAmount > 0
            && request.resource.data.approvedAmount < resource.data.amount)
          || (request.resource.data.status == 'denied'
            && request.resource.data.approvedAmount == 0)
        )
        && request.resource.data.updatedAt == request.time;
    }
    function validClaimPayout() {
      return resource.data.status in ['approved','partially_approved']
        && resource.data.payoutStatus == 'unpaid'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'payoutStatus','updatedAt'
        ])
        && request.resource.data.payoutStatus == 'paid'
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isStaff();
      allow list: if isStaff();
      allow create: if isOwner() || (isSelf(uid) && validCustomerProfile(uid));
      allow update: if isOwner()
        || (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName','updatedAt'])
          && validName(request.resource.data.displayName)
          && request.resource.data.updatedAt == request.time);
      allow delete: if isOwner();
    }

    match /plans/{planId} {
      allow get, list: if signedIn();
      allow create: if isOwner() && validPlanData()
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner() && validPlanData()
        && request.resource.data.createdAt == resource.data.createdAt;
      // Retire plans rather than deleting them so policies remain referentially valid.
      allow delete: if false;
    }

    match /policies/{uid} {
      // Approved providers may verify a specific member's coverage using their
      // patient-supplied Member ID, but cannot browse/list policies.
      allow get: if isSelf(uid) || isStaff() || isProvider();
      allow list: if isStaff();
      allow create: if isOwner() || (isSelf(uid) && validCustomerPolicy(uid));
      allow update: if isOwner()
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['pending','active','suspended','cancelled']
          && request.resource.data.updatedAt == request.time)
        || (isSelf(uid)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['plan','updatedAt'])
          && activePlan(request.resource.data.plan)
          && request.resource.data.updatedAt == request.time);
      allow delete: if isOwner();
    }

    match /claims/{claimId} {
      // Query all claims only as staff; patients can query their own
      // customerUid and approved providers can query their providerUid.
      allow get, list: if isStaff()
        || (signedIn() && resource.data.customerUid == request.auth.uid)
        || (isProvider() && resource.data.providerUid == request.auth.uid);
      allow create: if signedIn() && validClaimCreate();
      allow update: if isStaff() && (validClaimDecision() || validClaimPayout());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
