rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.owner == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(value) {
      return value is string && value.size() >= 1 && value.size() <= 80;
    }
    function validCustomerProfile(uid) {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.uid == uid
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.role == 'customer'
      && validName(request.resource.data.displayName)
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }
    function validCustomerPolicy(uid) {
      return request.resource.data.keys().hasOnly([
        'uid', 'plan', 'status', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'uid', 'plan', 'status', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.uid == uid
      && request.resource.data.plan in ['basic', 'standard', 'premium']
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }
    match /users/{uid} {
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow create: if isOwner()
        || (isSelf(uid) && validCustomerProfile(uid));
      allow update: if isOwner()
        || (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt'])
          && validName(request.resource.data.displayName)
          && request.resource.data.updatedAt is timestamp);
      allow delete: if isOwner();
    }
    match /policies/{uid} {
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow create: if isOwner()
        || (isSelf(uid) && validCustomerPolicy(uid));
      allow update: if isOwner()
        || (isSelf(uid)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['plan', 'updatedAt'])
          && request.resource.data.plan in ['basic', 'standard', 'premium']
          && request.resource.data.updatedAt is timestamp);
      allow delete: if isOwner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
